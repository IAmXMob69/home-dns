# Writes nftables drop counters (geolock + country blocks) for Prometheus.
# See docs/nft-counters.md. Runs as root only because nft needs CAP_NET_ADMIN.
[Unit]
Description=home-dns: export nftables drop counters to /var/lib/home-dns/metrics/nft.prom

[Service]
Type=oneshot
# StateDirectory creates the directory and makes it writable under
# ProtectSystem=strict. (ReadWritePaths= on a missing path fails the unit.)
StateDirectory=home-dns/metrics
StateDirectoryMode=0755
# Not under /usr/local/lib/home-dns: install-geolock-system.sh --rollback
# replaces that directory.
ExecStart=/usr/local/sbin/home-dns-nft-counters --output /var/lib/home-dns/metrics/nft.prom
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
Nice=10
IOSchedulingClass=idle
