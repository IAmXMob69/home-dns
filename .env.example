# Copy to .env and fill in. Never commit .env.
# Optional timezone for the Pi-hole container
TZ=UTC

# SIGN-IN: Pi-hole web page  http://127.0.0.1/admin/
# There is no username. This value is the password you type.
FTLCONF_webserver_api_password=change-me-long-random

# SIGN-IN: Grafana graphs (only if you turn monitoring on)
# Open http://127.0.0.1:3000  — username is always: admin
GRAFANA_ADMIN_PASSWORD=change-me-too

# Stable LAN IPv4 of THIS machine (Pi-hole host). Not 0.0.0.0.
LAN_IPV4=192.168.1.X
LAN_CIDR=192.168.1.0/24
LAN_GATEWAY=192.168.1.X

# Optional: LAN IPv6 address on the NIC (EUI-64). Leave empty to skip IPv6 DNS binds.
# Never use [::] on a host with a global IPv6 address.
LAN_IPV6=

# Tailscale IPv4 of this node (tailscale ip -4). Used in local DNS host records.
TAILSCALE_IPV4=100.x.x.x

# Compose file list. Add the Tailscale overlay when that IP is set:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
COMPOSE_FILE=docker-compose.yml

# ---- Host tools (harden.sh, expose-lan.sh, watchdog, update-pihole, ...) ----
# Only needed for the Linux host scripts. Each one stops with a plain message
# naming the setting it is missing. Values with "your-" count as unset.
# NetworkManager connection and device:  nmcli -t -f NAME,DEVICE connection show --active
WIFI_CON=your-connection-name
WIFI_DEV=your-device
# Optional LAN IPv6 prefix allowed to reach DNS (e.g. from: ip -6 route). Empty = IPv4 only.
LAN_IPV6_CIDR=
# TLS name the DoT cert answers to (scripts/refresh-dot-cert.sh). Or set PIHOLE_DNS=127.0.0.1#<name>.
DOT_AUTH_NAME=your-host.your-tailnet.ts.net
# Optional Tailscale node name for join-tailnet.sh. Empty = keep the OS hostname.
TS_HOSTNAME=
# Login that owns the checkout, for sudo scripts (defaults to $SUDO_USER).
PIHOLE_USER=
# Optional adlist file for automation/import-lists (default pihole-automation/lists.txt).
#IMPORT_LISTS_FILE=

# Admin HTTPS cert SANs for scripts/harden-pihole-tls.sh (optional).
# Comma-separated. Do not commit real hostnames into the repo; set them in .env.
# ADMIN_TLS_DNS=your-host.your-tailnet.ts.net
# ADMIN_TLS_IP=127.0.0.1,192.168.1.X,100.x.x.x
# ADMIN_TLS_ALG=ecdsa-p384
