# Copy to .env and fill in. Never commit .env.
# Optional timezone for the Pi-hole container
TZ=UTC

# SIGN-IN: Pi-hole web page  http://127.0.0.1/admin/
# There is no username. This value is the password you type.
FTLCONF_webserver_api_password=change-me-long-random

# SIGN-IN: Grafana graphs (only if you turn monitoring on)
# Open http://127.0.0.1:3000  — username is always: admin
GRAFANA_ADMIN_PASSWORD=change-me-too

# Stable LAN IPv4 of THIS machine (Pi-hole host). Not 0.0.0.0.
LAN_IPV4=192.168.1.X
LAN_CIDR=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# Optional: LAN IPv6 address on the NIC (EUI-64). Leave empty to skip IPv6 DNS binds.
# Never use [::] on a host with a global IPv6 address.
LAN_IPV6=

# Tailscale IPv4 of this node (tailscale ip -4). Used in local DNS host records.
TAILSCALE_IPV4=100.x.x.x

# Compose file list. Add the Tailscale overlay when that IP is set:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
COMPOSE_FILE=docker-compose.yml
