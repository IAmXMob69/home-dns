# Copy to geolock/settings.env (gitignored). Do not put hostnames, LAN prefixes, or names here.

# 0 = no table / flush existing geolock table
GEOLOCK_ENABLED=0

# allow = drop the world except listed ISO codes (+ LAN/loopback/Tailscale CGNAT)
# deny  = drop listed ISO codes only
GEOLOCK_MODE=allow

# Default allowlist template
GEOLOCK_ALLOW_COUNTRIES=US,DE

# Deny-list used when GEOLOCK_MODE=deny (ISO 3166-1 alpha-2)
# Matches the country gate used with this stack (India, Israel, Saudi, Africa).
GEOLOCK_DENY_COUNTRIES=IN,PK,BD,LK,NP,BT,MV,AF,IL,SA,NG,KE,ZA,EG,GH,TZ,UG,MA,DZ,TN,ET,CI,SN,CM,AO,MZ,ZW,ZM,RW,SD,LY,MG,MW,ML,BF,NE,TD,SO,SS,BI,BJ,BW,CF,CG,CV,DJ,ER,GA,GM,GN,GQ,GW,KM,LR,LS,MR,MU,NA,SC,SL,ST,SZ,TG,CD,RE

# Ports on the host to wrap (Pi-hole DNS + Unbound DoT)
GEOLOCK_PORTS=53,853

# Re-download a country list once its cache is older than this many days.
GEOLOCK_MAX_AGE_DAYS=7

# 1 = also build ip6 sets (pass6 + listed6) and filter IPv6 with the same countries.
# 0 = IPv4 only. In allow mode that leaves IPv6 unfiltered (IPv6 clients are not geolocked).
# Countries with no IPv6 list upstream (e.g. CF, ER) are logged and contribute nothing.
GEOLOCK_IPV6=0

# Directions are independent; at least one must be 1.
# INBOUND  = input/forward chains (who may query this host's DNS ports)
# OUTBOUND = output chain (which upstream servers this host's DNS may reach)
GEOLOCK_INBOUND=1
GEOLOCK_OUTBOUND=1
