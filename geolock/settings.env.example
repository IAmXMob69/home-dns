# Copy to geolock/settings.env (gitignored). Do not put hostnames, LAN prefixes, or names here.

# 0 = no table / flush existing geolock table
GEOLOCK_ENABLED=0

# allow = drop the world except listed ISO codes (+ LAN/loopback/Tailscale CGNAT)
# deny  = drop listed ISO codes only
GEOLOCK_MODE=allow

# Default allowlist template
GEOLOCK_ALLOW_COUNTRIES=US,DE

# Deny-list used when GEOLOCK_MODE=deny (ISO 3166-1 alpha-2)
# Matches the country gate used with this stack (India, Israel, Saudi, Africa).
GEOLOCK_DENY_COUNTRIES=IN,IL,SA,NG,KE,ZA,EG,GH,TZ,UG,MA,DZ,TN,ET,CI,SN,CM,AO,MZ,ZW,ZM,RW,SD,LY,MG,MW,ML,BF,NE,TD,SO,SS,BI,BJ,BW,CF,CG,CV,DJ,ER,GA,GM,GN,GQ,GW,KM,LR,LS,MR,MU,NA,SC,SL,ST,SZ,TG,CD,RE

# Ports on the host to wrap (Pi-hole DNS + Unbound DoT)
GEOLOCK_PORTS=53,853
