# Go build of monitoring/pihole-exporter.py: static binary on scratch.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /pihole-exporter ./cmd/pihole-exporter

FROM scratch
COPY --from=build /pihole-exporter /pihole-exporter
EXPOSE 9617
ENTRYPOINT ["/pihole-exporter"]
